# Per-date alert dedup state (ephemeral, regenerated each day)
tracking_data/alerts_state_*.json

# Backtest feature cache (auto-rebuilt on schema/data change; see data/feature_cache.py)
tracking_data/cache/

# Runtime logs (auto_dump.sh, launchd stdout/stderr — rotating, not source)
logs/

# Superpowers brainstorming session artifacts (mockups, event logs)
.superpowers/

# Playwright MCP session artifacts
.playwright-mcp/

# Large local DB binaries — too big for git (704MB; GitHub blocks files >100MB).
# The recoverable subset is committed as tracking_data/backup/db_core_dump.sql.gz
# (~2.6MB, refreshed via `python3 -m scripts.dump_db`); restore with
# `python3 -m scripts.restore_db`.
tracking_data/horse_history.db
tracking_data/odds_history.db
tracking_data/uk_history.db
tracking_data/au_history.db
tracking_data/jp_history.db
tracking_data/fr_history.db
tracking_data/horse_history.db-shm
tracking_data/horse_history.db-wal
tracking_data/odds_history.db-shm
tracking_data/odds_history.db-wal
tracking_data/uk_history.db-shm
tracking_data/uk_history.db-wal
tracking_data/au_history.db-shm
tracking_data/au_history.db-wal
tracking_data/jp_history.db-shm
tracking_data/jp_history.db-wal
tracking_data/fr_history.db-shm
tracking_data/fr_history.db-wal

# Renavon one-time export CSVs (~76MB gzipped, frozen 2026-04-26).
# Tracked in git so the DB can be rebuilt via `python3 -m scripts.load_renavon_csvs`
# after any local DB loss. Never updated (one-time HKJC export, no subscription).
# See docs/renavon.md.
