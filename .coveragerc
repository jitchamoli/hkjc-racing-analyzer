[run]
branch = True
source = .
omit =
    tests/*
    scripts/launchd/*
    */__pycache__/*
    setup.py
    conftest.py

[report]
exclude_lines =
    pragma: no cover
    def __repr__
    raise NotImplementedError
    if __name__ == .__main__.:
    if TYPE_CHECKING:
precision = 1
show_missing = True
skip_covered = False

[html]
directory = htmlcov
