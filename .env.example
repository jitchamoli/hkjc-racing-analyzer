# Environment variable template — copy to .env and fill in real values.
# The actual .env file is gitignored (.gitignore line 18) so secrets stay local.
#
# Setup:
#   cp .env.example .env
#   # then edit .env with your real API key

# The Racing API (https://www.theracingapi.com) — UK + IRE + HK racing data.
# Sign up for a free 2-week trial, get credentials from Dashboard → API Keys.
# Uses HTTP Basic Auth — both username AND password are required for every
# request. Find both in your Racing API dashboard after signup.
RACING_API_USERNAME=
RACING_API_PASSWORD=
